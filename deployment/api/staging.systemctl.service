[Unit]
Description=Staging API
After=network.target postgres.service

[Service]
User=ubuntu
Restart=always
WorkingDirectory=/data/api/stag/
Environment="ENV=STAG"
Environment="SQLALCHEMY_DATABASE_URI=postgresql://pgusername:pg-password-to-update@127.0.0.1/pgusername_ads_stag"
ExecStart=/data/api/stag/venv/bin/python -m gunicorn -w 4 -b 127.0.0.1:8800 wsgi:api --timeout 120 --capture-output --disable-redirect-access-to-syslog --access-logfile -

[Install]
WantedBy=multi-user.target
