[Unit]
Description=Production API
After=network.target postgres.service

[Service]
User=ubuntu
Restart=always
WorkingDirectory=/data/api/prod/
Environment="SQLALCHEMY_DATABASE_URI=postgresql://pgusername:pg-password-to-update@127.0.0.1/pg_db_prod_name"
ExecStart=/data/api/stag/venv/bin/python -m gunicorn -w 4 -b 127.0.0.1:8000 wsgi:api --timeout 120 --capture-output --disable-redirect-access-to-syslog --access-logfile -

[Install]
WantedBy=multi-user.target
